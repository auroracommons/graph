OCATION"},{"text":"Texas","type":"LOCATION"}],"id":"musk companies","relations":[{"source":"Elon Musk","target":"SpaceX","type":"founded_by"},{"source":"SpaceX","target":"Hawthorne","type":"located_in"},{"source":"SpaceX","target":"California","type":"located_in"},{"source":"Elon Musk","target":"Tesla","type":"works_for"},{"source":"Tesla","target":"Austin","type":"located_in"},{"source":"Tesla","target":"Texas","type":"located_in"}],"text":"Elon Musk founded SpaceX in 2002. SpaceX is headquartered in Hawthorne, California. Elon Musk also leads Tesla, an electric vehicle company based in Austin, Texas."},{"entities":[{"text":"Marie Curie","type":"PERSON"},{"text":"Warsaw","type":"LOCATION"},{"text":"Poland","type":"LOCATION"},{"text":"1867","type":"DATE"},{"text":"Pierre Curie","type":"PERSON"},{"text":"Paris","type":"LOCATION"},{"text":"1898","type":"DATE"}],"id":"curie","relations":[{"source":"Marie Curie","target":"Warsaw","type":"born_in"},{"source":"Marie Curie","target":"Poland","type":"born_in"}],"text":"Marie Curie was born in Warsaw, Poland, in 1867. Working with Pierre Curie in Paris, she discovered radium in 1898."},{"entities":[{"text":"IBM","type":"ORGANIZATION"},{"text":"1911","type":"DATE"},{"text":"Armonk","type":"LOCATION"},{"text":"New York","type":"LOCATION"},{"text":"Watson","type":"TECHNOLOGY"},{"text":"2011","type":"DATE"},{"text":"Ginni Rometty","type":"PERSON"},{"text":"2012","type":"DATE"},{"text":"2020","type":"DATE"}],"id":"ibm","relations":[{"source":"IBM","target":"Armonk","type":"located_in"},{"source":"IBM","target":"New York","type":"located_in"},{"source":"IBM","target":"Watson","type":"developed"},{"source":"Ginni Rometty","target":"IBM","type":"works_for"}],"text":"IBM, founded in 1911, is headquartered in Armonk, New York. IBM developed Watson, a question answering system, in 2011. Ginni Rometty served as CEO of IBM from 2012 to 2020."},{"entities":[{"text":"Mark Zuckerberg","type":"PERSON"},{"text":"Facebook","type":"ORGANIZATION